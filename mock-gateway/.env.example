# Untuk menjalankan mock gateway di luar Docker (`pnpm start` / `node --env-file=.env ...`).
# Dibuat & disinkronkan otomatis oleh ./scripts/setup-env.sh dari .env root.
PORT=4000
WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/payment-gateway
MAX_RETRIES=3
RETRY_BASE_MS=1000
# Harus sama dengan secret di backend
HMAC_SECRET_UCN=
HMAC_SECRET_ITSB=
HMAC_SECRET_PHB=
