# Sumber konfigurasi untuk docker compose & semua service.
# Buat/perbarui lewat ./scripts/setup-env.sh (nilai __GENERATE__ diisi acak). JANGAN di-commit.

# ---- Umum ----
APP_TIMEZONE=Asia/Jakarta

# ---- Database ----
POSTGRES_DB=ukt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__

# ---- Backend ----
BACKEND_PORT=3000
JWT_SECRET=__GENERATE__
JWT_EXPIRES_IN=8h
# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:8080
SWAGGER_ENABLED=true
# Jalankan seed data demo setiap kali backend start (idempoten)
SEED_ON_START=true
# Password semua akun demo hasil seed
SEED_DEMO_PASSWORD=Password123!
# Interval job kedaluwarsa otomatis (ms); 0 = nonaktif
EXPIRY_SWEEP_INTERVAL_MS=60000

# Secret HMAC-SHA256 per institusi (backend: verifikasi, mock gateway: tanda tangan)
HMAC_SECRET_UCN=__GENERATE__
HMAC_SECRET_ITSB=__GENERATE__
HMAC_SECRET_PHB=__GENERATE__

# ---- Frontend ----
# Jika diisi, halaman login menampilkan tombol isi-cepat akun demo dengan password ini.
# Kosongkan untuk menyembunyikannya.
FRONTEND_DEMO_PASSWORD=Password123!

# ---- Mock gateway ----
GATEWAY_PORT=4000
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BASE_MS=1000

# ---- Port di host (ubah jika bentrok) ----
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8080
GATEWAY_HOST_PORT=4000
