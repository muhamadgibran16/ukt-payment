# Untuk menjalankan backend di luar Docker (`pnpm start:dev`, migration, seed).
# Dibuat & disinkronkan otomatis oleh ./scripts/setup-env.sh dari .env root.

# ---- App ----
NODE_ENV=development
PORT=3000
# Pisahkan dengan koma, atau * untuk mengizinkan semua origin
CORS_ORIGIN=*
# Default: aktif kecuali NODE_ENV=production
# SWAGGER_ENABLED=true
TZ=Asia/Jakarta

# ---- Database ---- (cocok dengan `docker compose up -d postgres` di root repo)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ukt
DB_USER=postgres
DB_PASSWORD=postgres
# Jangan aktifkan; skema hanya diubah lewat migration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---- Auth ----
# Wajib minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# ---- Rate limit ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---- Job kedaluwarsa otomatis (ms). 0 = nonaktif ----
EXPIRY_SWEEP_INTERVAL_MS=60000

# ---- Seed (hanya dibaca oleh `pnpm seed`) ----
# Password untuk semua akun demo (wajib).
SEED_DEMO_PASSWORD=Password123!
# Secret HMAC per institusi. Jika kosong, seed men-generate secret acak dan mencetaknya.
HMAC_SECRET_UCN=
HMAC_SECRET_ITSB=
HMAC_SECRET_PHB=
