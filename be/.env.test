# Dipakai oleh test e2e (pnpm test:e2e). Database ini DIHAPUS isinya setiap test
# dan dibuat otomatis jika belum ada. Default cocok dengan `docker compose up -d postgres`
# di root repo (Postgres di host port 5433).
NODE_ENV=test
PORT=3001
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ukt_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
JWT_SECRET=test-secret-test-secret-test-secret-1234
JWT_EXPIRES_IN=15m
THROTTLE_LIMIT=1000
EXPIRY_SWEEP_INTERVAL_MS=0
