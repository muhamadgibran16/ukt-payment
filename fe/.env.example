# Untuk `pnpm dev` / `pnpm build` di luar Docker.
# Dibuat & disinkronkan otomatis oleh ./scripts/setup-env.sh dari .env root.
# Base URL API (diproksi Vite saat dev, nginx saat produksi).
VITE_API_URL=/api/v1
# Target proksi /api untuk Vite dev server.
VITE_PROXY_TARGET=http://localhost:3000
# Zona waktu institusi (wajib), untuk tampilan tanggal & batas bayar.
VITE_APP_TIMEZONE=Asia/Jakarta
# Opsional: tampilkan tombol akun demo di halaman login dengan password ini.
VITE_DEMO_PASSWORD=Password123!
